@startuml RemindLedger - System Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context - RemindLedger

Person(user, "End User", "Busy person managing daily reminders (e.g. meds, tasks)")

System(remindledger, "RemindLedger", "Reminder service: register reminders, get notified at configured time")

Rel(user, remindledger, "Creates reminders, receives notifications")

@enduml

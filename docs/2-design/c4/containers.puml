@startuml RemindLedger - Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container View - RemindLedger

Person(user, "End User", "Busy person managing daily reminders (e.g. meds, tasks)")

System_Boundary(remindledger, "RemindLedger") { 
  Container(webapp, "Web App", "Web UI", "Allows the user to manage reminders via browser.")
  Container(api, "Backend API", "Application Service", "Exposes APIs to manage reminders and orchestrate notifications.")
  ContainerDb(db, "Database", "Data Store", "Stores reminders, user preferences, and notification state.")
  Container(worker, "Reminder Worker", "Scheduler / Worker", "Checks for due reminders and triggers notifications.")
}

System_Ext(notify, "Notification Provider", "Email/SMS/Web Push service", "")

Rel(user, webapp, "Uses", "HTTPS")
Lay_L(webapp, user)

Rel(webapp, api, "Calls APIs", "HTTPS")
Rel(api, webapp, "Pushes notifications", "WebSocket")
Rel(api, db, "Reads/writes reminders", "SQL/Query")
Rel(api, worker, "Schedules / dispatches jobs", "Queue / events")
Rel(worker, db, "Reads due reminders", "SQL/Query")
Rel(worker, notify, "Sends notification requests", "HTTP/API")

Rel(notify, user, "Delivers notifications", "Email/SMS/Web Push")
Lay_D(user, notify)

@enduml
